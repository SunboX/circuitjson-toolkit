{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ECAD Print SVG Snapshot v1",
    "type": "object",
    "required": [
        "apiVersion",
        "schemaVersion",
        "svg",
        "bounds",
        "units",
        "textRuns",
        "diagnostics"
    ],
    "properties": {
        "apiVersion": {
            "const": 1
        },
        "schemaVersion": {
            "const": 1
        },
        "svg": {
            "type": "string"
        },
        "units": {
            "const": "mm"
        },
        "bounds": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "width": {
                    "type": "number"
                },
                "height": {
                    "type": "number"
                }
            }
        },
        "transform": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
        },
        "textRuns": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "sourceId",
                    "text",
                    "renderMode",
                    "fontSize",
                    "glyphs",
                    "matrix",
                    "visible"
                ],
                "properties": {
                    "sourceId": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "originalText": {
                        "type": "string"
                    },
                    "renderMode": {
                        "const": "stroke"
                    },
                    "fontSize": {
                        "type": "number"
                    },
                    "matrix": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 6,
                        "maxItems": 6
                    },
                    "bounds": {
                        "type": "object",
                        "required": ["x", "y", "width", "height"],
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "width": {
                                "type": "number"
                            },
                            "height": {
                                "type": "number"
                            }
                        }
                    },
                    "clipBounds": {
                        "type": "object",
                        "required": ["x", "y", "width", "height"],
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "width": {
                                "type": "number"
                            },
                            "height": {
                                "type": "number"
                            }
                        }
                    },
                    "visible": {
                        "const": true
                    },
                    "glyphs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "text",
                                "x",
                                "y",
                                "advance",
                                "fontSize"
                            ],
                            "properties": {
                                "text": {
                                    "type": "string"
                                },
                                "x": {
                                    "type": "number"
                                },
                                "y": {
                                    "type": "number"
                                },
                                "advance": {
                                    "type": "number"
                                },
                                "fontSize": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                }
            }
        },
        "diagnostics": {
            "type": "array"
        }
    }
}
